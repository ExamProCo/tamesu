# Copy the values you need into ~/.tamesu/.env, <project>/.env, or
# <project>/.tamesu/.env. See docs/configuration.md for precedence.
# Set only the credentials needed by the providers in your eval manifests.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROK_API_KEY=
META_API_KEY=
AWS_BEARER_TOKEN_BEDROCK=

# BEDROCK_REGION=us-east-1
# BEDROCK_API_KEY=  # accepted as an alternative to AWS_BEARER_TOKEN_BEDROCK

# Optional endpoint overrides, primarily for local integration tests.
# TAMESU_OPENAI_BASE_URL=https://api.openai.com/v1
# TAMESU_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# TAMESU_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GROK_BASE_URL=https://api.x.ai/v1
# META_BASE_URL=https://api.meta.ai/v1
# TAMESU_BEDROCK_BASE_URL=https://bedrock-runtime.us-east-1.amazonaws.com
