{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tamesu.dev/schemas/publication.schema.json",
  "title": "Tamesu publication metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "publisher", "version", "title", "summary", "authors", "license", "profile"],
  "properties": {
    "schema_version": {"const": 1},
    "name": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "publisher": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "authors": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
    "license": {"type": "string", "minLength": 1},
    "tags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}},
    "profile": {"enum": ["full", "rescorable", "report-only"]},
    "data_review": {"type": "object", "required": ["acknowledged", "note"], "properties": {"acknowledged": {"const": true}, "note": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "forked_from": {"type": "object", "additionalProperties": false, "required": ["publisher", "name", "version", "content_digest"], "properties": {"publisher": {"type": "string"}, "name": {"type": "string"}, "version": {"type": "string"}, "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}
  },
  "allOf": [{"if": {"properties": {"profile": {"enum": ["full", "rescorable"]}}}, "then": {"required": ["data_review"]}}]
}
