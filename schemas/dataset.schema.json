{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tamesu.dev/schemas/dataset.schema.json",
  "title": "Tamesu dataset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "description", "items"],
  "properties": {
    "schema_version": {"const": 1},
    "name": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "description": {"type": "string", "minLength": 1},
    "shared_assets": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {"type": "string", "minLength": 1}
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "input": {"type": "object"},
          "assets": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            }
          },
          "expected": true,
          "metadata": {"type": "object"}
        }
      }
    }
  }
}
