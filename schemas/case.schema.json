{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tamesu.dev/schemas/case.schema.json",
  "title": "Tamesu case manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "description",
    "business_use",
    "current_problem"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "business_use": {
      "type": "string",
      "minLength": 1
    },
    "current_problem": {
      "type": "string",
      "minLength": 1
    },
    "technical_uncertainty": {
      "type": "string",
      "minLength": 1
    },
    "default_task": {
      "type": "string",
      "minLength": 1
    }
  }
}
