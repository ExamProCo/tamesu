{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tamesu.dev/schemas/rubric.schema.json",
  "title": "Tamesu rubric",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "dimensions",
    "acceptance"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "description": {
      "type": "string"
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "description": "Relative path to the human-readable rationale."
    },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "question",
          "reason_codes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "reason_codes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(?!none$)[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          }
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule"
      ],
      "properties": {
        "rule": {
          "enum": [
            "all_dimensions_pass"
          ]
        }
      }
    }
  }
}
