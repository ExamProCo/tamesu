{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tamesu.dev/schemas/report.schema.json",
  "title": "Tamesu run report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "generated_at",
    "scorer_version",
    "identity",
    "completion",
    "metrics",
    "totals",
    "items"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "scorer_version": {"type": "string", "minLength": 1},
    "identity": {"type": "object"},
    "completion": {
      "type": "object",
      "required": ["selected_items", "completed_items", "failed_items"],
      "properties": {
        "selected_items": {"type": "integer", "minimum": 0},
        "completed_items": {"type": "integer", "minimum": 0},
        "failed_items": {"type": "integer", "minimum": 0}
      }
    },
    "metrics": {"type": "object"},
    "totals": {"type": "object"},
    "evidence": {"type": "object"},
    "items": {"type": "array", "items": {"type": "object"}}
  }
}
