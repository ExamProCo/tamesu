{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tamesu experiment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "description",
    "hypothesis",
    "success_criteria"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "success_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
